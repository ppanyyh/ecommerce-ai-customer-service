<Slide style={{ width: 1280, height: 720, padding: '20px 60px', background: '#FFFFFF' }}>
  <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1A2333' }}>产品方案与核心流程</Text>
    <Text style={{ fontSize: 15, color: '#94A3B8' }}>02 / 方案设计</Text>
  </Box>
  <Box style={{ flexDirection: 'row', gap: 24, height: 520, marginTop: 8 }}>
    <Box style={{ width: 384, background: '#F8FAFE', borderRadius: 12, padding: 10, alignItems: 'center', justifyContent: 'center' }}>
      <Image src="assets/flowchart.png" style={{ width: 364, height: 478, objectFit: 'contain' }} />
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#FFFFFF', border: '1px solid #DBE4F5', borderRadius: 12, padding: '16px 20px' }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2333', marginBottom: 12 }}>核心业务流程 · 七个环节</Text>
        <Box style={{ flexDirection: 'row', gap: 10, marginBottom: 10 }}>
          {['用户提问', '输入有效性校验', '订单号识别', '问题分类'].map((s, i) => (
            <Box key={i} style={{ flex: 1, background: '#EFF4FF', borderRadius: 8, padding: '10px 8px', alignItems: 'center' }}>
              <Text style={{ fontSize: 12, color: '#2563EB', fontWeight: 'bold', marginBottom: 2 }}>STEP {i + 1}</Text>
              <Text style={{ fontSize: 14, color: '#1A2333', textAlign: 'center' }}>{s}</Text>
            </Box>
          ))}
        </Box>
        <Box style={{ flexDirection: 'row', gap: 10, marginBottom: 10 }}>
          {['资料检索', '生成建议回复', '风险判断', '回复或转人工'].map((s, i) => (
            <Box key={i} style={{ flex: 1, background: '#EFF4FF', borderRadius: 8, padding: '10px 8px', alignItems: 'center' }}>
              <Text style={{ fontSize: 12, color: '#2563EB', fontWeight: 'bold', marginBottom: 2 }}>STEP {i + 5}</Text>
              <Text style={{ fontSize: 14, color: '#1A2333', textAlign: 'center' }}>{s}</Text>
            </Box>
          ))}
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ flex: 1, height: 2, background: '#DBE4F5' }} />
          <Text style={{ fontSize: 13, color: '#64748B' }}>每条回答附用户反馈入口（有帮助 / 无帮助），闭环沉淀</Text>
          <Box style={{ flex: 1, height: 2, background: '#DBE4F5' }} />
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2333' }}>四类知识源 · 回答的唯一依据</Text>
        <Box style={{ flexDirection: 'row', gap: 10, flex: 1 }}>
          {[
            { t: '商品资料', d: '5款商品的参数、价格、材质、保修' },
            { t: '客服FAQ', d: '20条标准问答，按5类问题组织' },
            { t: '售后SOP', d: '售后流程、七天无理由与转人工规则' },
            { t: '模拟订单', d: '3笔订单15字段，含数量与售后状态' }
          ].map((k, i) => (
            <Box key={i} style={{ flex: 1, background: '#F4F7FE', borderRadius: 10, padding: '12px 14px', justifyContent: 'center' }}>
              <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2563EB', marginBottom: 5 }}>{k.t}</Text>
              <Text style={{ fontSize: 12.5, color: '#64748B', lineHeight: 1.45 }}>{k.d}</Text>
            </Box>
          ))}
        </Box>
        <Box style={{ background: '#2563EB', borderRadius: 10, padding: '12px 16px', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
          <Text style={{ fontSize: 14, color: '#FFFFFF', lineHeight: 1.5 }}>有依据 → 回答并展示依据；无依据 → 明确告知「资料未覆盖」，绝不编造</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 13, color: '#94A3B8' }}>电商客服AI助手 · 个人作品集</Text>
    <Text style={{ fontSize: 13, color: '#94A3B8' }}>03 / 07</Text>
  </Box>
</Slide>
